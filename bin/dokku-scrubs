#!/usr/bin/env bash

set -euo pipefail

LIB_DIR="/usr/local/lib/dokku-scrubs"
ETC_DIR="/usr/local/etc"

# If you are developing Dokku Scrubs and installing locally from source,
# uncomment the following two lines before installing.
#LIB_DIR="$HOME/.local/lib/dokku-scrubs"
#ETC_DIR="$HOME/.local/etc"

source "$LIB_DIR/config.sh"
source "$LIB_DIR/common.sh"
source "$LIB_DIR/init.sh"
source "$LIB_DIR/db.sh"
source "$LIB_DIR/app.sh"
source "$LIB_DIR/domains.sh"
source "$LIB_DIR/letsencrypt.sh"
source "$LIB_DIR/post-deploy.sh"
source "$LIB_DIR/shflags"

DEFINE_string  "app"            "" "the type of app to deploy" "a"
DEFINE_string  "appversion"     "$DEFAULT_APP_VERSION" "the app's image tag. default: $DEFAULT_APP_VERSION" "V"
DEFINE_string  "domain"         "" "the domain of your server" "d"
DEFINE_boolean "wwwsubdomain"   false "pass this flag to add the www. subdomain to your app's domain config" "w"
DEFINE_string  "dokkutag"       "$DEFAULT_DOKKU_TAG" "version of Dokku to use. default: $DEFAULT_DOKKU_TAG" "t"
DEFINE_string  "database"       "" "the type of database to use, leave blank to use the app's default" "D"
DEFINE_string  "email"          "" "email address for letsencrypt" "e"
DEFINE_boolean "letsencrypt"    false "pass this flag to enable SSL" "l"
DEFINE_boolean "testcert"       false "pass this flag along with --letsencrypt, to get certs from the staging server" "T"
DEFINE_boolean "secondary"      false "install as a secondary app on a subdomain"
DEFINE_boolean "sslnoautorenew" false "don't auto renew certificate on expiry"
DEFINE_boolean "local"          false "pass this flag to deploy your app on a local workstation"
DEFINE_integer "nginxport"     "$DEFAULT_NGINX_PORT" "the port for Nginx to listen on. set it if running on a local workstation, otherwise leave it blank" "p"
DEFINE_boolean "dokkufromsource" false "install Dokku from source instead of latest release"

DEFINE_boolean "version" false "show version and exit" "v"

FLAGS "$@" || exit $?
eval set -- "${FLAGS_ARGV}"

if [[ ${FLAGS_version} -eq ${FLAGS_TRUE} ]]; then
  echo "dokku-scrubs v$DOKKU_SCRUBS_VERSION"
  exit 0
fi

require_root

if [[ -z "${FLAGS_app}" ]]; then
  log "--app is required."
  exit 1
fi

if [[ -z "${FLAGS_domain}" && ${FLAGS_local} -ne ${FLAGS_TRUE} ]]; then
  log "You must either specify --domain or pass the --local flag"
  exit 1
fi

if [[ ${FLAGS_local} -eq ${FLAGS_TRUE} ]]; then
  if [[ ! -z "${FLAGS_domain}" ]]; then
    log "--local and --domain cannot be used together."
    exit 1
  fi

  if [[ ${FLAGS_letsencrypt} -eq ${FLAGS_TRUE} ]]; then
    log "--local and --letsencrypt cannot be used together."
    exit 1
  fi

  if [[ ${FLAGS_wwwsubdomain} -eq ${FLAGS_TRUE} ]]; then
    log "--local and --wwwsubdomain cannot be used together."
    exit 1
  fi

  if [[ ${FLAGS_secondary} -eq ${FLAGS_TRUE} ]]; then
    log "--local and --secondary cannot be used together."
    exit 1
  fi
fi

if [[ ($FLAGS_nginxport -lt 0) || ($FLAGS_nginxport -gt 65535) ]]; then
  log "--nginxport must be between 0 and 65535."
  exit 1
fi

if [[ ${FLAGS_letsencrypt} -eq ${FLAGS_TRUE} && -z "${FLAGS_email}" ]]; then
  log "--email is required when setting --letsencrypt"
  exit 1
fi

if [[ ${FLAGS_wwwsubdomain} -eq ${FLAGS_TRUE} && ${FLAGS_secondary} -eq ${FLAGS_TRUE} ]]; then
  log "--wwwsubdomain cannot be used with --secondary"
  exit 1
fi

if [[ -z "${FLAGS_database}" ]]; then
  database="${APP_DB[${FLAGS_app}]}"
else
  database="${FLAGS_database}"
fi

if [[ ${FLAGS_local} -eq ${FLAGS_TRUE} ]]; then
  domain="localhost"
else
  domain="${FLAGS_domain#www.}"
fi

init_system "${FLAGS_app}"
init_dokku "${FLAGS_dokkutag}" "$database" "$domain" "${FLAGS_dokkufromsource}"
create_app "${FLAGS_app}"
setup_db "$database" "${FLAGS_app}"
mount_volumes "${FLAGS_app}" "${FLAGS_appversion}"
deploy_app "${FLAGS_app}" "$domain" \
  "${FLAGS_wwwsubdomain}" "${FLAGS_secondary}" "${FLAGS_appversion}"
map_port "${FLAGS_app}" "${FLAGS_nginxport}"

if [ ${FLAGS_letsencrypt} -eq ${FLAGS_TRUE} ]; then
  enable_ssl "${FLAGS_app}" "${FLAGS_email}" "${FLAGS_testcert}" "${FLAGS_sslnoautorenew}"
fi

post_deploy
